{
  "name": "Customer Segmentation Theme",
  "dataColors": [
    "#2E86AB",
    "#12A07A",
    "#F08C00",
    "#D1495B",
    "#8A5CD1",
    "#8D99AE",
    "#1B2A47",
    "#5FB4D9"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2A47",
  "tableAccent": "#12A07A",
  "good": "#12A07A",
  "neutral": "#F08C00",
  "bad": "#D1495B",
  "maximum": "#1B2A47",
  "center": "#5FB4D9",
  "minimum": "#E3F2F9",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B2A47"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B2A47"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#3A4150"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#1B2A47"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1B2A47" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#DFE4EC" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#C7CFDB" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#EEF2F7" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#E3E8F0" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#1B2A47" } },
            "textSize": 11
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#3A4150" } },
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1B2A47" } }
          }
        ]
      }
    }
  }
}
